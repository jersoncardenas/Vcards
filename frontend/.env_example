# ==============================================================================================================
# FRONTEND CONFIGURACION (Astro)
# ==============================================================================================================
# Host y puerto donde corre el frontend en desarrollo
# ==============================================================================================================
FRONTEND_HOST=localhost
FRONTEND_PORT=4321

# ==============================================================================================================
# URL pública del backend (FastAPI) al que el frontend hace las peticiones
# ==============================================================================================================
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_FRONTEND_URL=http://localhost:4321

# PostgreSQL (solo servidor; no usar prefijo PUBLIC_)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vcards_db
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
ADMIN_USER=administrador
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
ADMIN_SESSION_SECRET=GENERA_UN_SECRETO_LARGO_Y_ALEATORIO
